#
# Build rules for Time To (Pebble SDK 4.44+).
#
import json
import os.path

top = '.'
out = 'build'

# Optional firmware APIs: enabled automatically once the installed SDK exports them.
OPTIONAL_APIS = {
    'vibes_enqueue_custom_pattern_with_amplitudes': 'TT_HAVE_VIBE_AMPLITUDES',
}


def options(ctx):
    ctx.load('pebble_sdk')


# The plugin script and the settings page are single files on the phone with no
# `require`, so the shared modules in src/common are bundled into them here.
SHARED_MODULES = ['ttrows', 'store']


def _module_bundle(ctx, wanted):
    parts = ['var __tt_modules = {};']
    for name in wanted:
        source = ctx.path.find_node('src/common/{}.js'.format(name)).read()
        parts.append('(function (module, exports) {\n%s\n})(__tt_modules[%s] = { exports: {} }, '
                     '__tt_modules[%s].exports);' % (source, json.dumps(name), json.dumps(name)))
    parts.append('function require(path) {\n'
                 '  var name = String(path).replace(/^.*\\//, \'\').replace(/\\.js$/, \'\');\n'
                 '  return __tt_modules[name].exports;\n'
                 '}')
    return '\n'.join(parts)


def _write_if_changed(node, text):
    if not os.path.exists(node.abspath()) or node.read() != text:
        node.parent.mkdir()
        node.write(text)


def _generate(ctx):
    """src/generated/plugin.js and src/generated/config.html, from their sources."""
    banner = 'Generated by wscript. Edit {} instead.'
    bundle = _module_bundle(ctx, SHARED_MODULES)
    plugin = ctx.path.find_node('src/plugin/plugin.js')
    if plugin is not None:
        _write_if_changed(ctx.path.make_node('src/generated/plugin.js'),
                          '// ' + banner.format('src/plugin/plugin.js') + '\n' +
                          '(function () {\n' + bundle + '\n' + plugin.read() + '\n})();\n')
    page = ctx.path.find_node('src/config/config.src.html')
    if page is not None:
        html = page.read().replace('<!-- @TT_MODULES@ -->',
                                   '<script>\n' + bundle + '\n</script>')
        _write_if_changed(ctx.path.make_node('src/generated/config.html'),
                          '<!-- ' + banner.format('src/config/config.src.html') + ' -->\n' + html)


def configure(ctx):
    _generate(ctx)
    ctx.load('pebble_sdk')
    for platform in ctx.env.TARGET_PLATFORMS:
        env = ctx.all_envs[platform]
        header = os.path.join(str(env.PEBBLE_SDK_PLATFORM), 'include', 'pebble.h')
        try:
            with open(header) as f:
                text = f.read()
        except (IOError, OSError):
            text = ''
        for symbol, define in OPTIONAL_APIS.items():
            if symbol in text:
                env.append_value('DEFINES', [define])


def build(ctx):
    _generate(ctx)
    ctx.load('pebble_sdk')

    binaries = []
    cached_env = ctx.env
    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.env = ctx.all_envs[platform]
        ctx.set_group(ctx.env.PLATFORM_NAME)
        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)
        ctx.pbl_build(source=ctx.path.ant_glob('src/c/**/*.c'), target=app_elf, bin_type='app')
        binaries.append({'platform': platform, 'app_elf': app_elf})
    ctx.env = cached_env

    ctx.set_group('bundle')
    ctx.pbl_bundle(binaries=binaries,
                   js=ctx.path.ant_glob(['src/pkjs/**/*.js',
                                         'src/pkjs/**/*.json',
                                         'src/common/**/*.js']),
                   js_entry_file='src/pkjs/index.js')
