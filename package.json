{
  "name": "time-to",
  "author": "blainemauri",
  "version": "1.0.0",
  "keywords": [
    "pebble-app",
    "alarm",
    "reminder"
  ],
  "private": true,
  "license": "GPL-3.0-or-later",
  "dependencies": {},
  "pebble": {
    "displayName": "Time To",
    "uuid": "78ff0b72-3e3c-45d8-bb73-45381a822bd6",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable"
    ],
    "messageKeys": [
      "TT_OP",
      "TT_KIND",
      "TT_TEXT",
      "TT_GEN"
    ],
    "resources": {
      "media": []
    },
    "configPage": "src/generated/config.html",
    "usesPermissions": [
      {
        "name": "Timeline",
        "reason": "To show your upcoming alarms in the watch timeline",
        "required": false
      },
      {
        "name": "WatchMicrophone",
        "reason": "To dictate an alarm's message on the watch",
        "required": false
      }
    ],
    "plugin": {
      "description": "Time To alarms: lists the alarms coming up next and lets other apps and the assistant set a new alarm or reminder.",
      "script": "src/generated/plugin.js",
      "sources": [
        {
          "category": "alarms",
          "items": [
            "upcoming"
          ],
          "properties": {
            "name": [
              "shortText",
              "longText"
            ],
            "time": [
              "timestamp",
              "shortText",
              "longText"
            ],
            "day": [
              "shortText"
            ],
            "snoozed": [
              "boolean"
            ]
          },
          "supportsMultiple": true,
          "suggestedRefreshIntervalSec": 300
        },
        {
          "category": "alarms",
          "items": [
            "all"
          ],
          "properties": {
            "name": [
              "shortText",
              "longText"
            ],
            "schedule": [
              "longText"
            ],
            "on": [
              "boolean"
            ],
            "row": [
              "longText"
            ]
          },
          "supportsMultiple": true,
          "suggestedRefreshIntervalSec": 900
        },
        {
          "category": "reminders",
          "items": [
            "configured"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "configured": [
              "boolean",
              "shortText"
            ]
          },
          "supportsMultiple": false,
          "suggestedRefreshIntervalSec": 3600
        }
      ],
      "actions": [
        {
          "name": "add_alarm",
          "description": "Create an alarm on the watch. Easiest: `text` like '7:30 weekdays Wake up' or '18:00 in 3 days Call mum'. Or give `time` (HH:MM, 24h) and optionally `rule` ('daily', 'weekdays', 'weekly=mo.we.fr', 'monthly=15', 'monthly=-1' for the last day, 'nth=2tu' for the 2nd Tuesday, 'yearly=03-14', 'yday=256', a date like '2026-12-25', 'tomorrow', 'friday' or 'in 3 days'), `message`, and snooze lengths such as '10m' or '117h'. Or pass a whole CSV `row`.",
          "parameters": {
            "type": "object",
            "properties": {
              "time": {
                "type": "string",
                "description": "Time of day, HH:MM in 24-hour form."
              },
              "rule": {
                "type": "string",
                "description": "When it repeats. Defaults to the next time that clock time comes round, once."
              },
              "message": {
                "type": "string",
                "description": "Text shown when the alarm rings."
              },
              "snooze_a": {
                "type": "string",
                "description": "Snooze length for the top button, e.g. '3m'."
              },
              "snooze_b": {
                "type": "string",
                "description": "Snooze length for the bottom button, e.g. '30m'."
              },
              "row": {
                "type": "string",
                "description": "A complete alarm CSV row, instead of the fields above."
              },
              "text": {
                "type": "string",
                "description": "Or one line such as '7:30 weekdays Wake up' or '18:00 in 3 days Call mum': the time, then when, then the message."
              }
            },
            "required": []
          },
          "targets": [
            "alarms/upcoming",
            "alarms/all"
          ]
        },
        {
          "name": "create_reminder",
          "description": "Create a one-off Time To alarm as a reminder. due_iso is an absolute ISO-8601 instant; without it the reminder rings in one hour.",
          "parameters": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Reminder title."
              },
              "due_iso": {
                "type": "string",
                "format": "date-time",
                "description": "Optional absolute due instant in ISO-8601 format."
              },
              "timezone": {
                "type": "string",
                "description": "IANA time-zone context for due_iso."
              },
              "notify_before_ms": {
                "type": "integer",
                "minimum": 0,
                "description": "Optional lead time in milliseconds."
              },
              "instanceId": {
                "type": "string",
                "description": "Unused."
              }
            },
            "required": [
              "title"
            ]
          },
          "targets": [
            "alarms/upcoming",
            "alarms/all"
          ]
        }
      ]
    }
  }
}
